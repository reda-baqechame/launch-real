# Optional — LaunchReel runs fully client-side without these.
# For hosted SaaS (you own API keys, users pay via Stripe), set Clerk + DATABASE_URL + ANTHROPIC_API_KEY.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only full test mode (ignored unless NODE_ENV != production and host is localhost/127.0.0.1)
LAUNCHREEL_LOCAL_FREE_MODE=false

# Dev-only comma-separated hosts the browser agent may visit over HTTP/private networks.
# Ignored in production. Example: localhost,127.0.0.1,staging.internal
LAUNCHREEL_AGENT_ALLOWED_HOSTS=

# Server AI keys (hosted SaaS — never expose to the browser)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# fal.ai key — powers Seedance cinematic video shots.
# Hosted SaaS: set here. Client-only mode: users add their own in Settings (sent as x-fal-key).
FAL_KEY=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres (Neon, Supabase, etc.)
DATABASE_URL=

# Stripe credits
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_LAUNCH=
STRIPE_PRICE_FOUNDER_PRO=
STRIPE_PRICE_STUDIO=

# Trigger.dev render queue
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Remotion Lambda
REMOTION_LAMBDA_FUNCTION_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Object storage (S3 or Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=

# OAuth — YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Product Hunt
PRODUCT_HUNT_CLIENT_ID=
PRODUCT_HUNT_CLIENT_SECRET=

# Webhook auth for /api/render-queue/complete (required in production)
RENDER_WEBHOOK_SECRET=

# OAuth CSRF state signing (defaults to CLERK_SECRET_KEY if unset)
OAUTH_STATE_SECRET=
