# Optional — LaunchReel runs fully client-side without these.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres (Neon, Supabase, etc.)
DATABASE_URL=

# Stripe credits
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_LAUNCH=
STRIPE_PRICE_FOUNDER_PRO=
STRIPE_PRICE_STUDIO=

# Trigger.dev render queue
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Remotion Lambda
REMOTION_LAMBDA_FUNCTION_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Object storage (S3 or Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=

# OAuth — YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Product Hunt
PRODUCT_HUNT_CLIENT_ID=
PRODUCT_HUNT_CLIENT_SECRET=

# Webhook auth for /api/render-queue/complete (required in production)
RENDER_WEBHOOK_SECRET=

# OAuth CSRF state signing (defaults to CLERK_SECRET_KEY if unset)
OAUTH_STATE_SECRET=
