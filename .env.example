# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/dashboard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:pass@localhost:5432/launchreel

# Stripe (credits)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_LAUNCH=
STRIPE_PRICE_FOUNDER_PRO=
STRIPE_PRICE_STUDIO=

# Trigger.dev (cloud render queue)
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Remotion Lambda (optional cloud render)
REMOTION_LAMBDA_FUNCTION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# YouTube OAuth (upload)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Product Hunt OAuth
PRODUCT_HUNT_CLIENT_ID=
PRODUCT_HUNT_CLIENT_SECRET=

# Object storage (S3 or Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
