{
  "name": "launch-real",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:railway": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "verify": "npm run build && npm run lint",
    "smoke:ci": "node scripts/smoke-local-free.mjs",
    "smoke:agent-local": "powershell -ExecutionPolicy Bypass -File scripts/smoke-agent-local.ps1",
    "smoke:production-guard": "powershell -ExecutionPolicy Bypass -File scripts/smoke-production-guard.ps1",
    "smoke:real-providers": "powershell -ExecutionPolicy Bypass -File scripts/smoke-real-providers.ps1",
    "smoke:railway": "powershell -ExecutionPolicy Bypass -File scripts/smoke-railway.ps1",
    "prepare:env": "powershell -ExecutionPolicy Bypass -File scripts/prepare-env-local.ps1",
    "test:e2e": "node scripts/e2e-agent-local.js",
    "test:agent-evals": "powershell -ExecutionPolicy Bypass -File scripts/test-agent-evals.ps1",
    "security:scan": "powershell -ExecutionPolicy Bypass -File scripts/security-scan.ps1",
    "loop:tick": "powershell -ExecutionPolicy Bypass -File scripts/build-loop.ps1",
    "loop:start": "powershell -ExecutionPolicy Bypass -File scripts/start-build-loop.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-lambda": "^3.1068.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@clerk/nextjs": "^7.5.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
